# Infrastructure overrides for docker compose. No secrets belong in git.
SITE_ADDRESS=:80

# API container reaches the local Supabase stack on the host.
# The issuer must match the JWT `iss` claim, so it stays 127.0.0.1 locally.
API_SUPABASE_ISSUER=http://127.0.0.1:54321
API_SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
API_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost

# PowerSync
PS_DATA_SOURCE_URI=postgresql://powersync_role:powersync@host.docker.internal:54322/postgres
PS_STORAGE_URI=postgresql://postgres:powersync@powersync-db:5432/powersync
PS_JWKS_URI=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
PS_PORT=8080
PS_SSL_MODE=disable
POWERSYNC_DB_PASSWORD=powersync
POWERSYNC_API_TOKEN=change-me
