{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /v1/* {
		reverse_proxy api:8787
	}

	handle /health {
		reverse_proxy api:8787
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
