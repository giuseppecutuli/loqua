# Copy to .env for hosted Supabase, or create .env.local for the local Docker stack.
# .env.local overrides .env in every script and in the Expo build.

# Client (public)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_POWERSYNC_URL=

# Server / Hono secrets (never exposed to the client)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SMTP_URL=
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Primary AI provider: cheapest text tier.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional fallbacks (leave empty to keep costs at zero).
GEMINI_API_KEY=
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
AI_DAILY_BUDGET_USD=0.50

# Self-hosted PowerSync.
POWERSYNC_DB_PASSWORD=powersync
