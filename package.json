{
  "name": "loqua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @loqua/app dev",
    "android": "pnpm --filter @loqua/app android",
    "web": "pnpm --filter @loqua/app web",
    "api:dev": "pnpm --filter @loqua/api dev",
    "test": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage --reporter=dot",
    "test:rls": "node tools/db/test-rls.mjs",
    "test:sync": "vitest run packages/db/sqlite/src/sync.test.ts --reporter=dot",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @loqua/db-postgres db:generate",
    "db:migrate": "pnpm --filter @loqua/db-postgres db:migrate",
    "db:migrate:remote": "pnpm --filter @loqua/db-postgres db:migrate -- --remote",
    "db:ping": "node tools/db/ping.mjs",
    "smoke:supabase": "pnpm --filter @loqua/app smoke:supabase",
    "smoke:account": "pnpm --filter @loqua/api exec tsx scripts/smoke-account.ts",
    "smoke:e2e": "node tools/smoke/run-e2e.mjs",
    "smoke:ai": "pnpm --filter @loqua/app smoke:ai",
    "db:check": "pnpm --filter @loqua/db-postgres db:check",
    "sync:generate": "pnpm --filter @loqua/db-sqlite generate",
    "supabase:start": "pnpm --filter @loqua/db-postgres supabase:start",
    "supabase:stop": "pnpm --filter @loqua/db-postgres supabase:stop",
    "supabase:status": "pnpm --filter @loqua/db-postgres exec supabase status --workdir ../../..",
    "supabase:local:reset": "pnpm --filter @loqua/db-postgres exec supabase db reset --workdir ../../..",
    "supabase:reset": "node tools/db/reset.mjs",
    "powersync:setup": "node tools/db/setup-powersync.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=100",
    "infra:config": "docker compose -f infra/docker-compose.yml config",
    "seed": "node tools/seed/seed.mjs",
    "eval": "node tools/eval/run.mjs",
    "eval:recorded": "node tools/eval/run.mjs --recorded",
    "build:web": "pnpm --filter @loqua/app build:web",
    "verify": "node tools/verify/verify.mjs --level=fast",
    "verify:core": "node tools/verify/verify.mjs --level=core"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
