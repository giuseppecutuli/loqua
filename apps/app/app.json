{
  "expo": {
    "name": "Loqua",
    "slug": "loqua",
    "scheme": "loqua",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.loqua.mobile"
    },
    "android": {
      "package": "app.loqua.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
